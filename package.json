{
  "name": "eterna-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time meme coin data aggregation microservices",
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:aggregator\" \"npm run dev:gateway\" \"npm run dev:websocket\"",
    "dev:aggregator": "cd services/data-aggregator && npm run dev",
    "dev:gateway": "cd services/api-gateway && npm run dev",
    "dev:websocket": "cd services/websocket-server && npm run dev",
    "build": "npm run build --workspaces",
    "build:aggregator": "cd services/data-aggregator && npm run build",
    "build:gateway": "cd services/api-gateway && npm run build",
    "build:websocket": "cd services/websocket-server && npm run build",
    "install:all": "npm install && npm install --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "rm -rf node_modules services/*/node_modules services/*/dist"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
