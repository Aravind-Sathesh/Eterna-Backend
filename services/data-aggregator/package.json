{
  "name": "@eterna/data-aggregator",
  "version": "1.0.0",
  "description": "Real-time meme coin data aggregation service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:producer\" \"npm run dev:worker\"",
    "dev:producer": "tsx watch src/producer.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:legacy": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "concurrently \"npm run start:producer\" \"npm run start:worker\"",
    "start:producer": "node dist/producer.js",
    "start:worker": "node dist/worker.js",
    "start:legacy": "node dist/index.js",
    "test": "jest",
    "test:clients": "tsx src/test-clients.ts",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "meme-coin",
    "dex",
    "aggregator",
    "real-time"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@eterna/redis-client": "*",
    "@eterna/types": "*",
    "axios": "^1.6.2",
    "bullmq": "^5.1.0",
    "node-cron": "^3.0.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  }
}
